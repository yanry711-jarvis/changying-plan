<view class="page home">
  <view class="top"><view class="brand"><view class="mark">Y</view><text>长盈计划</text></view><view class="plan-link" bindtap="openPlans">我的计划</view></view>
  <view class="eyebrow">LONG-TERM INCOME PLANNER</view>
  <view class="hero">把今天的投入，<br/>变成未来的<text>现金流</text></view>
  <view class="income-card"><view class="income-head"><text>预计 {{summary.years}} 年后月均分红</text><text>↗</text></view><view><text class="yuan">¥</text><text class="income-num serif">{{summary.monthlyDividend}}</text></view><view class="spark"><view class="line a"></view><view class="line b"></view><view class="line c"></view><view class="line d"></view><view class="line e"></view></view><button class="start" bindtap="startPlan">开始测算　›</button></view>
  <view class="goal-row"><view class="goal-card" data-goal="retirement" bindtap="startPlan"><view class="goal-icon">⌂</view><text>退休计划</text><text class="arrow">›</text><view class="hill"></view></view><view class="goal-card edu" data-goal="education" bindtap="startPlan"><view class="goal-icon">⌑</view><text>子女教育金</text><text class="arrow">›</text><view class="books">▰▰▰</view></view></view>
  <view wx:if="{{plans.length}}" class="saved"><view class="saved-head"><text class="section-title">最近方案</text><text bindtap="openPlans">全部 ›</text></view><block wx:for="{{plans}}" wx:key="id"><view class="saved-item"><text>{{item.name}}</text><text>¥{{item.monthlyDividend}} / 月</text></view></block></view>
  <view class="risk">投资有风险，过往业绩不代表未来表现。本工具仅用于长期规划测算，不构成投资建议。</view>
</view>
