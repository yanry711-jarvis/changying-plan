.export-canvas{position:fixed;left:-9999rpx;top:-9999rpx;width:750rpx;height:1334rpx}.poster{background:linear-gradient(160deg,#0B3D2B 0,#164B37 34%,#FAF8F0 34.2%,#FAF8F0 100%);border-radius:26rpx;overflow:hidden;min-height:1070rpx;padding:43rpx 47rpx;box-sizing:border-box;box-shadow:0 13rpx 26rpx rgba(26,64,42,.12);color:#F7DFAF}.poster-brand{font-family:Georgia;font-size:32rpx}.poster-brand text{display:block;font-family:"PingFang SC";font-size:18rpx;letter-spacing:2rpx;margin-top:9rpx}.poster-title{font-family:Georgia,"Songti SC";font-size:51rpx;white-space:nowrap;margin-top:110rpx}.poster-sub{text-align:center;font-size:25rpx;margin-top:45rpx}.poster-num{color:#173C2B;text-align:center;margin-top:244rpx}.poster-num>text{font-family:Georgia;font-size:41rpx}.poster-num b{font-size:88rpx;font-weight:normal}.poster-num em{font-family:Georgia;color:#A77737;font-size:32rpx;font-style:normal}.poster-caption{text-align:center;color:#A77737;font-size:26rpx}.poster-chart{height:152rpx;display:flex;align-items:flex-end;gap:56rpx;border-bottom:1rpx solid #D3C8AD;margin:37rpx 10rpx 0}.dot{width:16rpx;border-radius:50% 50% 0 0;background:#3B7758}.d1{height:26rpx}.d2{height:43rpx}.d3{height:68rpx}.d4{height:95rpx}.d5{height:132rpx}.poster-foot{color:#284936;display:flex;justify-content:space-between;align-items:flex-end;margin:71rpx 5rpx 0;font-size:25rpx;line-height:1.8}.qr{font-size:90rpx;color:#254A35;border:1rpx solid #B6A57E;padding:8rpx;line-height:1}.share-tools{display:flex;gap:18rpx;margin:30rpx 0}.share-tools button{flex:1;border:1rpx solid #D4C4A7;background:#fff;color:#174D38;border-radius:16rpx;height:78rpx;line-height:78rpx;font-size:25rpx}.share .primary-btn{margin-top:8rpx}
