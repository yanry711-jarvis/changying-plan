<view class="page planner">
  <view class="tabs"><view class="tab {{mode==='single'?'active':''}}" data-mode="single" bindtap="setMode">单只银行股</view><view class="tab {{mode==='portfolio'?'active':''}}" data-mode="portfolio" bindtap="setMode">组合测算</view></view>
  <picker wx:if="{{mode==='single'}}" range="{{bankNames}}" value="{{bankIndex}}" bindchange="onBank"><view class="selector card"><view class="bank-icon">⌂</view><view><text>{{selectedName}}</text><text>{{updated}} 数据</text></view><text>›</text></view></picker>
  <picker wx:else range="{{portfolioNames}}" value="{{portfolioIndex}}" bindchange="onPortfolio"><view class="selector card"><view class="bank-icon">▦</view><view><text>{{selectedName}}</text><text>按权重计算默认参数</text></view><text>›</text></view></picker>
  <view class="method-row"><view class="method {{method==='term'?'checked':''}}" data-method="term" bindtap="setMethod"><text>按期限测算</text><text>看未来可能有多少</text></view><view class="method {{method==='target'?'checked':''}}" data-method="target" bindtap="setMethod"><text>按目标反推</text><text>反推每月要投多少</text></view></view>
  <view class="card form-card"><view class="form-head"><view class="dot">¥</view><text>投入计划</text></view><view class="field"><text>现有持仓</text><view><text>¥</text><input type="digit" value="{{initial}}" data-key="initial" bindinput="onField"/></view></view><view class="field"><text>每月定投</text><view><text>¥</text><input type="digit" value="{{monthly}}" data-key="monthly" bindinput="onField"/></view></view><view wx:if="{{method==='term'}}" class="years"><view><text class="years-value serif">{{years}}</text><text> 年</text></view><slider min="1" max="40" step="1" value="{{years}}" activeColor="#1D684A" backgroundColor="#DCE5DC" block-color="#1D684A" bindchange="onYears"/><view class="scale"><text>1 年</text><text>40 年</text></view></view><view wx:else class="field"><text>目标月分红</text><view><text>¥</text><input type="digit" value="{{target}}" data-key="target" bindinput="onField"/></view></view></view>
  <view class="card assumptions"><view class="form-head"><view class="dot">↗</view><text>收益假设</text></view><view class="rate"><text>预期税前股息率</text><view><input type="digit" value="{{yieldRate}}" data-key="yieldRate" bindinput="onField"/><text>%</text></view></view><view class="growth-title"><text>股息增长率</text><view><input type="digit" value="{{dividendGrowth}}" data-key="dividendGrowth" bindinput="onField"/><text>%</text></view></view><view class="presets"><view class="preset {{preset==='industry'?'picked':''}}" data-preset="industry" bindtap="setPreset">近10年行业平均<br/><b>3.0%</b></view><view class="preset {{preset==='safe'?'picked':''}}" data-preset="safe" bindtap="setPreset">保守<br/><b>1.5%</b></view><view class="preset {{preset==='optimistic'?'picked':''}}" data-preset="optimistic" bindtap="setPreset">乐观<br/><b>5.0%</b></view><view class="preset" data-preset="custom" bindtap="setPreset">自定义</view></view><view class="rate divider"><text>预期股价增长率</text><view><input type="digit" value="{{priceGrowth}}" data-key="priceGrowth" bindinput="onField"/><text>%</text></view></view><view class="reinvest"><view><text>红利再投资</text><text>将分红继续投入持仓</text></view><switch checked="{{reinvest}}" color="#1D684A" bindchange="onSwitch"/></view></view>
  <button class="primary-btn" bindtap="calculate">{{method==='target'?'反推定投方案':'查看现金流预测'}}</button><view class="data-note">参数来自本地数据文件，数据截至 {{updated}}，可自行调整</view>
</view>
