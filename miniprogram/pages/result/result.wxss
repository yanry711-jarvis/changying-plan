.hero-card{background:linear-gradient(135deg,#0E3E2D,#1D6549);padding:36rpx 34rpx;border-radius:28rpx;color:#F7F6ED;overflow:hidden}.hero-card>text{font-size:27rpx}.yen{font-size:46rpx;color:#F9DFAE}.hero-num{font-size:86rpx;color:#F9E0B1}.annual{border-top:1rpx solid rgba(255,255,255,.22);margin-top:10rpx;padding-top:18rpx;color:#E9E8D9;font-size:25rpx}.recommend{margin-top:18rpx;padding:23rpx 27rpx;border-radius:18rpx;background:#EFF6EA;display:flex;justify-content:space-between;align-items:center;color:#286B4C;font-size:24rpx}.recommend text:last-child{font-size:34rpx}.goal-ok{display:flex;align-items:center;gap:14rpx;background:#F0F5EC;border-radius:20rpx;padding:24rpx 26rpx;margin:20rpx 0;font-size:26rpx}.goal-ok view{background:#2A744F;color:#fff;width:52rpx;height:52rpx;border-radius:50%;text-align:center;line-height:52rpx;font-size:30rpx}.goal-ok text:nth-child(2){flex:1}.stat-row{display:flex;gap:18rpx}.stat{flex:1;padding:25rpx;min-width:0}.stat text{display:block;color:#647269;font-size:23rpx}.stat b{display:block;font-size:34rpx;margin-top:14rpx;color:#194934;white-space:nowrap}.chart-card{margin-top:20rpx;padding:26rpx}.chart{display:block;margin-top:12rpx}.detail-title{display:flex;justify-content:space-between;margin:45rpx 5rpx 17rpx}.detail-title text:last-child{color:#86938A;font-size:21rpx}.table{overflow:hidden}.row{display:grid;grid-template-columns:.65fr 1fr 1.13fr 1fr;padding:21rpx 17rpx;border-top:1rpx solid #EDF0EB;font-size:21rpx}.row text:not(:first-child){text-align:right}.header{background:#EDF4E9;color:#718075;font-size:19rpx;border:0}.green{color:#1E6949;font-family:Georgia}.gold{color:#9C6935;font-family:Georgia}.actions{display:flex;gap:18rpx;margin-top:34rpx}.actions button{flex:1;height:88rpx;line-height:88rpx;font-size:27rpx}.ghost{border:1rpx solid #1D684A;color:#1D684A;background:#fff;border-radius:17rpx}.action{margin:0}.share-btn{height:82rpx;line-height:82rpx;border:0;background:transparent;color:#1E684A;font-size:27rpx;margin-top:9rpx}
